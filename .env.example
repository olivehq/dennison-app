# Copy to .env.local for local runs. Every variable is optional locally: an
# empty value means "use the local default". Production needs the ones marked
# "required in production" (src/lib/env.ts refuses to start without them, D78).
# Set real values in Vercel, never in this file.

# --- Database and storage ---

# Postgres connection string. Unset means PGlite under LOCAL_DATA_DIR. Neon sets it on Vercel. Required in production.
# On Vercel use Neon's pooled connection string (its host contains "-pooler"): the app then keeps up to
# 5 connections per instance (D190). A direct connection string falls back to 1 and logs a warning.
# For the Docker database from `docker compose up -d`, uncomment:
# DATABASE_URL=postgres://aw:aw@localhost:5432/aw
DATABASE_URL=

# Folder for PGlite and local uploads when DATABASE_URL and Blob are unset. Local runs only; leave unset on Vercel.
LOCAL_DATA_DIR=.data

# Vercel Blob token for uploaded import files. Unset means files go to LOCAL_DATA_DIR/uploads. Required in production.
BLOB_READ_WRITE_TOKEN=

# --- App ---

# Public URL of this deployment, used in invite and schedule links. Required in production: https with a real public host, never localhost or example.com/org/net.
APP_URL=http://localhost:3000

# Better Auth signing secret: `openssl rand -base64 32`. Unset uses a fixed dev value. Required in production: random, at least 32 characters, no placeholders.
BETTER_AUTH_SECRET=

# Pepper for participant link hashes: `openssl rand -base64 32`. Changing it breaks every issued link. Required in production: random, at least 32 characters, no placeholders.
TOKEN_PEPPER=

# Bearer secret the Vercel Cron sends to /api/cron/retention: `openssl rand -base64 32`. Required in production: random, at least 32 characters, no placeholders.
CRON_SECRET=

# --- Email ---

# Resend API key with send access. Unset: email only goes to the server log and sends are disabled (production logs a warning at startup).
RESEND_API_KEY=

# Signing secret of the Resend webhook at /api/webhooks/resend. Set it with RESEND_API_KEY; production warns while it is unset.
RESEND_WEBHOOK_SECRET=

# Sender of invite and password emails, and the default sender of new campaigns, as `Name <address@verified-domain>`.
# Production warns while it is an example.com address, and refuses to send from one.
EMAIL_FROM="AW appointment matching <schedule@example.com>"

# Optional D&A support address, linked on invalid participant schedule pages. Unset shows contact text only.
SUPPORT_EMAIL=

# --- Sentry (all optional) ---

# Server and edge DSN from the Sentry project settings. Unset turns Sentry off.
SENTRY_DSN=

# Browser DSN, usually the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Build-time source map upload. The Sentry integration sets these on Vercel.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Scripts only (never on Vercel) ---

# Password for `pnpm create-admin` without a prompt (10+ characters).
ADMIN_PASSWORD=

# Set to 1 to let `pnpm db:seed` write to a non-local database or a production NODE_ENV.
SEED_ALLOW_REMOTE=

# --- Set by the platform, listed for completeness; don't set them yourself ---
# NODE_ENV, NEXT_PHASE, NEXT_RUNTIME (Next.js), VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV (Vercel), CI (CI runners).
